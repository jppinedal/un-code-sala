<mxCell id="f3_m3" value="3. grant, da permiso a ese estudiante" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="880" y="240" as="sourcePoint"/><mxPoint x="500" y="240" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="f3_m4" value="" style="html=1;endArrow=block;endSize=8;strokeWidth=1.5;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="500" y="302" as="sourcePoint"/><mxPoint x="500" y="328" as="targetPoint"/><Array as="points"><mxPoint x="546" y="302"/><mxPoint x="546" y="328"/></Array></mxGeometry></mxCell>
<mxCell id="f3_t4" value="4. Guarda el permiso por identificador de&lt;br&gt;navegador" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="556" y="298" width="300" height="36" as="geometry"/></mxCell>
<mxCell id="f3_m5" value="5. role editor, la sala pasa a ser editable" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;strokeWidth=1.5;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="500" y="372" as="sourcePoint"/><mxPoint x="120" y="372" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="f3_m6" value="6. Lista de personas actualizada" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;strokeWidth=1.5;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="500" y="418" as="sourcePoint"/><mxPoint x="880" y="418" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="f3_m7" value="7. revoke, quita el permiso" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="880" y="464" as="sourcePoint"/><mxPoint x="500" y="464" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="f3_m8" value="8. role viewer, vuelve a solo lectura y se&lt;br&gt;retira su cursor" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;strokeWidth=1.5;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="500" y="526" as="sourcePoint"/><mxPoint x="120" y="526" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="f3_note548" value="Solo el propietario puede dar o quitar permisos, el servidor rechaza esas órdenes de cualquier otra persona" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;align=center;" vertex="1" parent="1"><mxGeometry x="10" y="548" width="980" height="38" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
<diagram id="page5" name="5. Flujo: clase de 200 personas"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="f4_title" value="&lt;b&gt;UN Code Sala&lt;/b&gt; · Flujo 4 · Entrada de una clase de 200 personas" style="text;html=1;fontSize=20;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="900" height="34" as="geometry"/></mxCell>
<mxCell id="f4_LE" value="Estudiantes (200)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=44;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="56" width="180" height="378" as="geometry"/></mxCell>
<mxCell id="f4_LS" value="Servidor Node" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=44;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="410" y="56" width="180" height="378" as="geometry"/></mxCell>
<mxCell id="f4_LP" value="Profesor (propietario)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=44;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="790" y="56" width="180" height="378" as="geometry"/></mxCell>
<mxCell id="f4_m1" value="1. Abren el enlace y envían hello por WebSocket" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="148" as="sourcePoint"/><mxPoint x="500" y="148" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="f4_m2" value="" style="html=1;endArrow=block;endSize=8;strokeWidth=1.5;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="500" y="194" as="sourcePoint"/><mxPoint x="500" y="220" as="targetPoint"/><Array as="points"><mxPoint x="546" y="194"/><mxPoint x="546" y="220"/></Array></mxGeometry></mxCell>
<mxCell id="f4_t2" value="2. Agrupa los avisos de entrada durante 150 ms" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="556" y="190" width="300" height="20" as="geometry"/></mxCell>
<mxCell id="f4_m3" value="3. Lista completa de personas, con permisos y&lt;br&gt;solicitudes" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;strokeWidth=1.5;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="500" y="280" as="sourcePoint"/><mxPoint x="880" y="280" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="f4_m4" value="4. Lista reducida con propietario, editores, el&lt;br&gt;propio estudiante y el total" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;strokeWidth=1.5;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="500" y="342" as="sourcePoint"/><mxPoint x="120" y="342" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="f4_note364" value="Antes de este diseño cada estudiante recibía 1,9 MB al entrar, ahora recibe 0,8 KB" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;align=center;" vertex="1" parent="1"><mxGeometry x="10" y="364" width="980" height="38" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
<diagram id="page6" name="6. Despliegue en Azure"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="&lt;b&gt;UN Code Sala&lt;/b&gt; · Despliegue en Azure" style="text;html=1;fontSize=20;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="700" height="34" as="geometry"/></mxCell>
<mxCell id="d1" value="&lt;b&gt;Tu equipo&lt;/b&gt;&lt;br&gt;npm run build&lt;br&gt;esbuild compila el cliente" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="190" height="100" as="geometry"/></mxCell>
<mxCell id="d2" value="&lt;b&gt;publicar.ps1&lt;/b&gt;&lt;br&gt;server, shared, public y dist&lt;br&gt;+ 4 librerías, zip de 2,5 MB&lt;br&gt;Al final espera /version" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="290" y="80" width="230" height="100" as="geometry"/></mxCell>
<mxCell id="d3" value="&lt;b&gt;API de archivos de Kudu&lt;/b&gt;&lt;br&gt;Con tu sesión de Azure&lt;br&gt;(autenticación básica desactivada)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="590" y="80" width="210" height="100" as="geometry"/></mxCell>
<mxCell id="d4" value="&lt;b&gt;Kudu&lt;/b&gt;&lt;br&gt;Vacía la carpeta de la app y descomprime el zip&lt;br&gt;Sin compilar, luego reinicia" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="870" y="80" width="240" height="100" as="geometry"/></mxCell>
<mxCell id="d5" value="&lt;b&gt;App Service Linux B1&lt;/b&gt;&lt;br&gt;node server/index.js&lt;br&gt;Node 22 · 1 instancia · /home/data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1180" y="80" width="230" height="100" as="geometry"/></mxCell>
<mxCell id="d6" value="&lt;b&gt;Profesor y estudiantes&lt;/b&gt;&lt;br&gt;https://uncodesala-…azurewebsites.net&lt;br&gt;(la dirección lleva un sufijo aleatorio)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1160" y="300" width="270" height="100" as="geometry"/></mxCell>
<mxCell id="k1" value="&lt;b&gt;clase.ps1 subir / bajar&lt;/b&gt;&lt;br&gt;B1 durante la clase (~0,017 USD por hora)&lt;br&gt;F1 gratuito el resto, con solo 3 conexiones" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="640" y="300" width="250" height="100" as="geometry"/></mxCell>
<mxCell id="k2" value="&lt;b&gt;Control de costos&lt;/b&gt;&lt;br&gt;Presupuesto de aviso de 20 USD&lt;br&gt;Solo 2 recursos: plan + app&lt;br&gt;Sin Application Insights" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="920" y="300" width="210" height="100" as="geometry"/></mxCell>
<mxCell id="nota" value="&lt;b&gt;Por qué no se usa «az webapp deploy»&lt;/b&gt;&lt;br&gt;Su tubería de Kudu lanzaba una compilación interna que se colgaba (HTTP 502), incluso con el paquete ya compilado." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="30" y="300" width="560" height="100" as="geometry"/></mxCell>
<mxCell id="e1" edge="1" parent="1" source="d1" target="d2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e2" edge="1" parent="1" source="d2" target="d3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e3" edge="1" parent="1" source="d3" target="d4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e4" edge="1" parent="1" source="d4" target="d5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e5" value="https" edge="1" parent="1" source="d5" target="d6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e6" edge="1" parent="1" source="k1" target="d5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;dashed=1;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
